{
  "name": "pokr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tsc && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "build-only": "vite build",
    "tsc": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint src/**/*.{ts,vue}",
    "lint:fix": "eslint --fix src/**/*.{ts,vue}"
  },
  "dependencies": {
    "@vueuse/core": "14.1.0",
    "lottie-web-light": "1.1.0",
    "phoenix": "1.7.16",
    "pinia": "3.0.4",
    "qrcode": "^1.5.4",
    "vue": "3.5.25",
    "vue-router": "5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.12.0",
    "@types/phoenix": "1.6.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "@vitejs/plugin-vue": "6.0.4",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-vue": "9.32.0",
    "jsdom": "25.0.1",
    "rollup-plugin-analyzer": "4.0.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.7.3",
    "vite": "7.3.1",
    "vitest": "3.2.4",
    "vue-tsc": "3.2.4"
  }
}
